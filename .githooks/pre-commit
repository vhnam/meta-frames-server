#!/bin/sh
# Blocks the commit when gitleaks finds a secret in the staged changes, or when make lint fails.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Install it with 'brew install gitleaks' (https://github.com/gitleaks/gitleaks)." >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner || exit 1
# shortcut: lints the working tree, not only the staged changes.
make lint || { echo "pre-commit: make lint failed." >&2; exit 1; }
