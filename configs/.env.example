PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metaframes?sslmode=disable
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=data/scans   # uploaded scan files (local disk)
# DB_MAX_CONNS=10   # pgx pool size; default max(4, CPUs)
# ENV=production   # JSON logs
# Accounts
# SESSION_SAMESITE=lax   # lax (default), strict, or none for a front end on another site (forces Secure)
APP_URL=http://localhost:5173   # front end; recovery emails link to $APP_URL/recover/end?token=...
API_URL=http://localhost:8080   # this server as browsers reach it; Google returns to $API_URL/auth/oauth2/callback/google
# GOOGLE_CLIENT_ID=   # both set enables Sign in with Google
# GOOGLE_CLIENT_SECRET=
# MAIL_FROM=no-reply@example.com
# SMTP_ADDR=smtp.example.com:587   # unset prints emails to stdout
# SMTP_USERNAME=
# SMTP_PASSWORD=
